#!/usr/bin/env sh
# vim:tw=0:ts=2:sw=2:et:norl:ft=sh
# Author: Landon Bouma (landonb &#x40; retrosoft &#x2E; com)
# Project: https://github.com/landonb/home-fries#🍟
# License: MIT

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# OVIEW: A terminal `clear` command that *also* clears the clipboard.
#
# USAGE: Call directly, or put on PATH (e.g., under ~/.local/bin) and
# wire from ~/.inputrc binding, e.g., so you can use <Ctrl-L> to clear:
#
#   # ~/.inputrc
#   Control-l: 'clear\n'

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# HSTRY: Circa 2020, author created this command because I had issues
#        with the built-in macOS `clear` and `reset` commands.
#
# - I had noted in 2020 that `reset` "doesn't work on macOS", but it works
#   for me now (on Apple Silicon)
#
#   - I am unsure now if I similarly had issues with `clear` on macOS.
#
#   - I'm also unclear whether I had issues with Apple's commands (under
#     /usr/bin), or if it was the `ncurses` files (under /opt/local/bin).
#
# - But now, circa 2024, I don't (they work as expected on Apple Silicon).
#
# CALSO: See also the 3 built-in commands: clear, reset, and tset.
#
# - The `clear` command is the most simple of the three — It only
#   "clears your terminal's screen and its scrollback buffer".
#
#   - See also: `tset clear`.
#
# - Note that `reset` aliased to `tset`, but invoking as `reset` is
#   slightly different.
#
#   - The tset/reset commands perform `terminal initialization`.
#
#   - The `reset` command does same as `tset` plus a little more.
#
#     It's useful if a program (often through abnormal exit) leaves
#     the terminal in an abnormal state.
#
#   - You'll notice that `tset` (and `clear`) run basically
#     instantaneously, whereas `reset` sleeps for 1 second to let
#     the terminal "settle" (necessary for "real" hardware terminals).
#
#     - CXREF: https://github.com/mirror/ncurses/blob/v6.4/progs/tset.c#L883
#
#     However, I found a note that ncurses v6.5 (~2024) removes the one-second
#     delay.
#
#     - CXREF: https://unix.stackexchange.com/a/782808/388857
#
# - In practice, `tset` leaves a page of scrollback on macOS, but not on
#   Ubuntu, whereas neither `reset` nor `clear` leave any scrollback (on
#   either OS).
#
# - On Ubuntu, you'll find `clear`, `reset` (-> `tset`), and `tset`
#   under /usr/bin (and under /bin, but /bin -> usr/bin/).
#
# - On macOS, you may find `clear`, `reset` (-> `tset`), and `tset`
#   under *both* /usr/bin and /opt/local/bin, and they're different.
#
#   - The /usr/bin executables are core macOS files from Apple.
#
#   - The /opt/local/bin executables are from Homebrew `ncurses`.
#
#     - Per, e.g., `brew which-formula reset`.
#
# - Most often, all you need is `clear`.
#
# - REFER: If the man pages are not super *clear* (groan), see also
#   another user's summary of the differences between the commands:
#
#     https://unix.stackexchange.com/questions/670255/
#       what-is-the-difference-between-the-commands-clear-and-reset

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# Clear the screen, and then clear the scrollback buffer.
#
# - "Terminal supports an extension of the ED (Erase in Display)
#    escape sequence to erase the scroll-back."
#
#     https://apple.stackexchange.com/questions/31872/
#       how-do-i-reset-the-scrollback-in-the-terminal-via-a-shell-command
#
#     ESC [ Ps J
#
#       Parameter   Parameter Meaning
#
#       0           Erase from the active position to the end of the screen
#       1           Erase from start of the screen to the active position
#       2           Erase all of the display
#
#    https://www.vt100.net/docs/vt100-ug/chapter3.html#ED
#
# See also Edit > Clear Buffer (Cmd-K) in iTerm2.
#
# 1st answer to SE.com Q, 63 (up)votes [2020-09-18], is
# calling `clear` and sending ED command (see above).
#
#   alias clear='clear && printf "\\e[3J"'
#
# 2nd answer to SE.com Q, 31 (up)votes, suggests Cmd-K
# (View > Clear scrollback), and even automating with
# osascript, but a few issues:
# - This is OS- and terminal application-dependent; it'd
#   be better to use a portable, generic shell solution.
# - The author suggests using an osascript so you can at
#   least create a shell alias, but the command is still
#   OS- and application-dependent. E.g.,
#     osascript -e \
#       'tell application "System Events" to keystroke "k" using command down'
# - I've found that osascript is slow.
#
# 3rd answer to SE.com Q, 12 (up)votes:
# - The author suggests chaining CSI commands:
#   - CSI 2 J (E2): Clear visible.
#   - CSI 3 J (The "E3 extension"): Clear scrollback.
#   - CSI 1 ; 1 H (Cursor Position (CUP) command): Cursor to top-left.
# - I like this version — it's explicit, and it seems the most universal.
# - Also, `clear` on Linux Mint 19.3 doesn't *entirely* clear scrollback:
#   it scrolls the view so it looks like the screen is blank, but if you
#   page up, you'll see one screenful of scrollback. Fail!
# - Ref:
#   - See *HISTORY* in `man clear`
#   - See *XTerm Control Sequences*, e.g.:
#       https://www.x.org/docs/xterm/ctlseqs.pdf
#   - See *Erase in Display (ED)*:
#       https://en.wikipedia.org/wiki/ANSI_escape_code#CSI_sequences
#       https://en.wikipedia.org/wiki/ANSI_escape_code#Terminal_output_sequences
#       https://www.vt100.net/docs/vt100-ug/chapter3.html#ED
# - Meh:
#   - The CUP default is 1,1, so '\033[1;1H' → '\033[;H' → '\033[H';
#     also '\033' → '\e', so this could be shortened
#            printf "\\e[2J\\e[3J\\e[;H"'
#     but for some reason (compatibility?) I generally prefer \033 over \e.
#
# For posterity, here's an earlier tmux-friendly reset I had used to use:
#
#   if [ -n "${TMUX}" ]; then
#     alias reset='clear; tmux clear-history; command reset'
#   fi
#
# Also note that default readline maps <Ctrl-L> to clear-screen, e.g.,
#   # ~/.inputrc
#   Control-l: clear-screen
# but that leaves one page of scrollback [verified most recently 2024-10-30
# on macOS], unlike `/usr/bin/reset` or the following magic escape sequence.

clear_terminal_screen_and_scrollback_buffer () {
  printf "\\033[2J\\033[3J\\033[1;1H"
}

# Perform a clipboard clearance (sale), everything must go!
clear_clipboard_contents () {
  if type xclip > /dev/null 2>&1; then
    if [ -n "${DISPLAY}" ]; then
      printf '' | xclip -selection clipboard
    fi
  elif type pbcopy > /dev/null 2>&1; then
    pbcopy < /dev/null
  else
    >&2 echo "ALERT: Clipboard not cleared (neither xclip nor pbcopy)."
  fi
}

clear_terminal_screen_and_scrollback_buffer_and_clipboard_contents () {
  clear_terminal_screen_and_scrollback_buffer

  clear_clipboard_contents
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

main () {
  clear_terminal_screen_and_scrollback_buffer_and_clipboard_contents
}

main "$@"
unset -f main

